# OpenAI API key (required)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model for Responses API (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Prompt IDs from OpenAI dashboard (https://platform.openai.com/prompts)
# If set, that character uses your saved prompt instead of built-in instructions.
# OPENAI_CHAT_PROMPT_ID=pmpt_xxxxxxxx
# OPENAI_EVALUATOR_PROMPT_ID=pmpt_xxxxxxxx
# OPENAI_PROMPT_POTTER=pmpt_6a60938473a08194a798218ef5e27b890cb527a8c0c1959d
# OPENAI_PROMPT_RUPIN=pmpt_xxxxxxxx
# OPENAI_PROMPT_TOM=pmpt_xxxxxxxx

# Optional: pin a specific prompt version
# OPENAI_PROMPT_POTTER_VERSION=2

# Optional server port (default: 3000)
# PORT=3000
