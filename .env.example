OPENAI_API_KEY=

# Set to false to skip dashboard Prompt IDs and use built-in character prompts.
# OPENAI_USE_SAVED_PROMPTS=false

# Local dev: run `bun run dev` in macOS Terminal/iTerm (not a sandboxed shell).
# Cursor Agent/sandbox terminals block api.openai.com and cause 403 errors.
OPENAI_PROMPT_TOM=

# Pepper emotion chat API (Express server default port)
# PORT=3001
# PEPPER_CHAT_API_URL=http://127.0.0.1:3001/chat

# Include emotion state in POST /chat responses (development only)
DEBUG_EMOTION=true
