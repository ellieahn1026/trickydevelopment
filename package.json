{
  "name": "trickydevelopment",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:chat": "bun build ./chat.entry.js --outdir=. --entry-naming=\"chat.js\" --target=browser --minify --asset-naming=\"assets/[name]-[hash].[ext]\"",
    "build:pepper": "bun build ./src/pepper-main.tsx --outdir=. --entry-naming=\"pepper.js\" --target=browser --minify --asset-naming=\"assets/[name]-[hash].[ext]\"",
    "build:web": "bun run build:chat && bun run build:pepper",
    "dev": "bun --hot ./index.ts",
    "start": "bun ./index.ts",
    "agent:chat": "bun ./src/index.ts",
    "pepper:server": "tsx src/server.ts",
    "pepper:dev": "tsx watch src/server.ts",
    "pepper:server:bun": "bun src/server.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "openai": "^5.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
